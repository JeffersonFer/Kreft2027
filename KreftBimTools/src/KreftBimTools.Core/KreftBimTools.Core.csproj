<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug R25;Debug R26;Debug R27;Release R25;Release R26;Release R27</Configurations>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('R27'))">
		<TargetFrameworks>net10.0-windows</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup Condition="!$(Configuration.Contains('R27'))">
		<TargetFrameworks>net8.0-windows</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac" Version="9.3.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug R25;Debug R26;Debug R27;Release R25;Release R26;Release R27</Configurations>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<PropertyGroup Condition="$(Configuration.Contains('R27'))">
		<TargetFrameworks>net10.0-windows</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup Condition="!$(Configuration.Contains('R27'))">
		<TargetFrameworks>net8.0-windows</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
	</ItemGroup>

</Project>